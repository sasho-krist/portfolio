# Frontend (по избор): npm install && npm run build — създава assets/css/portfolio.min.css и assets/js/portfolio.min.js.
# Ако .min файловете съществуват, сайтът ги зарежда автоматично.

# Публичен URL на сайта (каноничен, с HTTPS) — за SEO: canonical, Open Graph, sitemap.
# Пример: https://example.com/ или https://example.com/portfolio/
# SITE_URL=https://example.com/

# Линк „Насрочи среща“ (Google Appointment schedule). Ако е зададен, замества calendar от data/profile.php.
# Създай/копирай от Google Календар → Настройки (колелце) → „Насрочване на срещи“ / Booking pages.
# CALENDAR_URL=https://calendar.google.com/calendar/u/0/r

# Plausible Analytics — домейн в dashboard (без https://). Празно = без скрипт.
# PLAUSIBLE_DOMAIN=example.com

# SMTP (като Laravel mail config)
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
# На споделен хостинг често 465 е блокиран за уеб — опитай първо 587 + tls:
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls

# Алтернатива (SSL от самото начало):
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl

# Изключи автоматичен втори опит 587+tls след неуспех на 465/ssl (по подразбиране е включен)
# MAIL_AUTO_FALLBACK_587=0

# Диагностика в PHP error_log
# MAIL_DEBUG=1

# WAMP / самоподписан или проблемен CA — често оправя „Could not connect“ / certificate
# MAIL_SSL_RELAX=1

# Принудително SMTPAutoTLS (рядко): 0 или 1
# MAIL_SMTP_AUTO_TLS=0

# При „Could not authenticate“ — опитай LOGIN; ако не стане, махни реда (кодът прави втори опит без него)
# MAIL_AUTH_TYPE=LOGIN
# MAIL_AUTH_RETRY_PLAIN=0

# EHLO име (по подразбиране: домейнът от MAIL_USERNAME, после HTTP_HOST)
# MAIL_EHLO_HOST=healthstore.bg

# Получател на контактните съобщения (по подразбиране: data/profile.php → email)
# MAIL_TO=alexander.krist@gmail.com

# След неуспешен SMTP: опит чрез PHP mail() (локален MTA). Изключи с 0 ако не искаш.
# MAIL_FALLBACK_PHP_MAIL=0

# AI чат (плаващ виджет) — ключ от https://platform.openai.com/api-keys
# Празно = виджетът не се показва. Никога не комитирай реален ключ.
# OPENAI_API_KEY=
# По избор: модел за chat completions (по подразбиране gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# WAMP/Windows: ако curl към api.openai.com дава SSL грешка, временно за локално:
# OPENAI_SSL_VERIFY=0
# По-добре: изтегли cacert.pem (https://curl.se/ca/cacert.pem) и в php.ini:
# curl.cainfo="C:/path/to/cacert.pem" и openssl.cafile= същият път
# Или само за този проект: OPENAI_CAFILE=C:/path/to/cacert.pem
# Логове от error_log (редове „portfolio chat …“): виж php.ini → error_log.
# WAMP: често C:\wamp64\logs\php_error.log или Apache error.log в C:\wamp64\logs\
